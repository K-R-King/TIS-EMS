# Rendered by the nginx image at startup; ${BACKEND_URL} comes from the environment.
server {
    listen 80;
    root /usr/share/nginx/html;

    # Receipts can be up to 10 MB
    client_max_body_size 12m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    # The API is served from the same address as the app, so the login cookie stays first-party
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 120s;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Single-page app: unknown paths load index.html and React Router takes over
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
