# Rendered by the nginx image at startup; ${BACKEND_URL} comes from the environment.
server {
    listen 8080;
    root /usr/share/nginx/html;
    server_tokens off;

    # Receipts can be up to 10 MB
    client_max_body_size 12m;

    # The API is served from the same address as the app, so the login cookie stays first-party
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 120s;
        # API responses keep the backend's own security headers (Spring Security)
    }

    # Built files have content hashes in their names, so they can be cached for a long time
    location /assets/ {
        expires 1y;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Single-page app: unknown paths load index.html (never cached, so new releases show up at once)
    location / {
        expires -1;
        try_files $uri /index.html;
        include /etc/nginx/snippets/security-headers.conf;
    }
}
